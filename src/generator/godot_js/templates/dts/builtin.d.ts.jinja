{#- 
    模板：builtin.d.ts.jinja
    用于生成 Godot 内置类型的 TypeScript 声明。
-#}
{% set renames = {'String': 'GDString', 'Array': 'GDArray'} %}
{% set class_name = renames.get(cls.name, cls.name) %}
{% set inherits = cls.inherits %}

{% macro extends_clause(inherits_name) %}
{% if inherits_name %} extends {{ inherits_name }}{% endif %}
{% endmacro %}

declare global {
    declare class {{ class_name }}{{ extends_clause(inherits) }} {
        {# 构造函数 (参数已由 connect_args 自动处理) #}
        {% for ctr in cls.constructors %}
        constructor({{ connect_args(ctr.arguments) }});
        {% endfor %}

        {# --- [修改 2] 对成员变量应用驼峰转换 --- #}
        {% for member in cls.members %}
        public {{ member.name }}: {{ set_type(member.type) }};
        {% endfor %}

        {# --- [修改 3] 对方法名应用驼峰转换 --- #}
        {% for method in cls.methods %}
        public{{ ' static' if method.is_static }} {{ method.name }}({{ connect_args(method.arguments) + process_vararg(method.is_vararg, method.arguments) }}){{- set_return(method.return_type) -}};
        {% endfor %}

        {# 枚举 (无需修改，保持 UPPER_CASE) #}
        {% for enum in cls.enums %}
        public static readonly {{ enum.name }}: {
            {% for value in enum['values'] %}
            {{ value.name }}: {{ value.value }};
            {% endfor %}
        };
        {% endfor %}
    }
}

export {};