{%- macro clean_type(e) -%}
	{%- if e.startswith("enum::") -%}
{{-e[6:] | replace(".", "::")-}}
	{%- elif e.startswith("bitfield::") -%}
{{-e[10:] | replace(".", "::")}}
	{%- elif "int" in e and "typedarray::" in e-%}
PackedInt32Array
	{%- elif e.startswith("typedarray::") -%}
Packed{{-e[12] | upper -}}{{-e[13:]-}}Array
	{%- else -%}
{{-e-}}
	{%- endif -%}
{%- endmacro -%}
