TypedArray<{{-e[12:]-}}>
	{%- else -%}
{{e}}
	{% endif %}
{% endmacro %}
{% macro clean_setter(e) %}
{%- if e[0] == "_" -%}
{{-e[1:]-}}
{%- else -%}
{{-e-}}
{%- endif -%}
