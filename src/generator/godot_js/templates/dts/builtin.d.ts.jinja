{#-
    模板：builtin.d.ts.jinja
    用于生成 Godot 内置类型的 TypeScript 声明。

    此模板采用 "声明合并" 模式：
    1. `export interface`: 定义类型的“形状”，允许使用对象字面量 (e.g., { x: 0, y: 0 })。
       它包含实例属性 (members) 和实例方法 (methods)。
    2. `export declare const`: 定义与类型同名的构造函数和静态成员 (e.g., new Vector2(), Vector2.ZERO)。
       它包含构造函数 (constructors) 和静态常量 (constants)。
-#}
{% set class_name = get_class_name(cls.name) %}

/**
 * Godot's built-in {{ cls.name }} type.
 *
 * As a data structure, it can be represented by a plain object.
 * @example
 * let my_vector: {{ class_name }} = { x: 1, y: 0 };
 *
 * To create a new instance, use the global constructor.
 * @example
 * const my_vector = new {{ class_name }}(1, 0);
 */
export interface {{ class_name }} {
    {# INSTANCE PROPERTIES (from cls.members) #}
    {% for member in cls.members %}
    {{ snake_to_camel(member.name) }}: {{ set_type(member.type) }};
    {% endfor %}

    {# INSTANCE METHODS (from cls.methods) #}
    {% for method in cls.methods %}
    {{ snake_to_camel(method.name) }}({{ connect_args(method.arguments) + process_vararg(method.is_vararg, method.arguments) }}){{ set_return(method.return_type) }};
    {% endfor %}
}

/**
 * A global constructor and namespace for the {{ class_name }} type.
 *
 * Use `new {{ class_name }}(...)` to create a new instance.
 * Access static members like `{{ class_name }}.ZERO`.
 */
export declare const {{ class_name }}: {
    {# CONSTRUCTORS (from cls.constructors) #}
    {% for ctr in cls.constructors %}
    new({{ connect_args(ctr.arguments) }}): {{ class_name }};
    {% endfor %}

    {# STATIC CONSTANTS (from cls.constants) #}
    {% for constant in cls.constants %}
    readonly {{ constant.name }}: {{ class_name }};
    {% endfor %}

    {# OPERATORS (Commented out as they don't map directly to JS/TS methods) #}
    /*
    {% for op in cls.operators %}
    // {{ get_operator_name(op.name) }}({{ set_type(op.right_type) }}): {{ set_type(op.return_type) }}
    {% endfor %}
    */
};
